# Vazio = confirmação simulada; nenhum pedido é enviado ao restaurante.
# Quando a API existir, coloque a URL base no arquivo .env.local.
# Exemplo: VITE_API_URL=http://localhost:3000/api
# Requisição esperada: POST /pedidos. Resposta: { "id": "123" }.
# Variáveis VITE_ são públicas no navegador. Não coloque senhas ou tokens aqui.
VITE_API_URL=
