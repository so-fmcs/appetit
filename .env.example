# O cardápio usa /api/pratos do backend. Em desenvolvimento, o Vite encaminha /api para localhost:8080.
# Para usar uma API em outro endereço, configure VITE_API_URL no arquivo .env.local.
# Exemplo: VITE_API_URL=https://meu-backend.example/api
# Se VITE_API_URL ficar vazio, o envio do pedido continua simulado.
# Variáveis VITE_ são públicas no navegador. Não coloque senhas ou tokens aqui.
VITE_API_URL=
